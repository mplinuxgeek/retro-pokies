{
  "name": "Retro Pokies",
  "short_name": "Retro Pokies",
  "description": "Plays pokie game ROMs you own, in the browser. ROMs stay on your device.",
  "start_url": "games.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0c0703",
  "theme_color": "#0c0703",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
