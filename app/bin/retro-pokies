#!/bin/sh
# Starts the desktop player with the node on PATH (or ./node/bin/node next to this folder in a packaged build).
# usage: retro-pokies [ROM folder | ROM zip]
here=$(cd "$(dirname "$0")/.." && pwd)
node="$here/node/bin/node"; [ -x "$node" ] || node=node
exec "$node" "$here/src/main.js" "$@"
